# Copy to /opt/mage-os-ideas/.env, chmod 600. Never commit the real file.
FIDER_IMAGE=mage-os-fider:REPLACE_WITH_GIT_SHA
POSTGRES_IMAGE=postgres:17
CLOUDFLARED_IMAGE=cloudflare/cloudflared:REPLACE_WITH_PINNED_VERSION
FIDER_DOMAIN=ideas.mage-os.org

# openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE
# openssl rand -hex 64
JWT_SECRET=REPLACE

EMAIL_NOREPLY=ideas@mage-os.org
EMAIL_SMTP_HOST=REPLACE
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=REPLACE
EMAIL_SMTP_PASSWORD='REPLACE'

# Cloudflare Zero Trust → Networks → Tunnels → token for the tunnel routing FIDER_DOMAIN to http://app:3000
CLOUDFLARE_TUNNEL_TOKEN=REPLACE

# Leave empty until GitHub sync is approved. Generate with: openssl rand -hex 32
MAGEOS_GITHUB_WEBHOOK_SECRET=
MAGEOS_GITHUB_AUTO_STATUS=false

# Encrypts nightly backups. age public key only; keep the private key off this server.
BACKUP_AGE_RECIPIENT=REPLACE
